rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /orders/{orderId} {
      allow create: if true;
      allow read: if true;
      allow update, delete: if false;
    }
    match /b2b_inquiries/{inquiryId} {
      allow create: if true;
      allow read: if false;
      allow update, delete: if false;
    }
    match /lead_samples/{sampleId} {
      allow create: if true;
      allow read: if false;
      allow update, delete: if false;
    }
  }
}
